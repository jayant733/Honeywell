# Path to the EnergyPlus executable or installation directory.
ENERGYPLUS_PATH=

# Local OpenAI-compatible endpoint serving Qwen 3 14B Instruct.
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=qwen3-14b-instruct

# Runtime configuration.
SENTINEL_ENV=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DATA_DIR=data/runtime
